<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.realsolutions.uikit.navbar.RSNavBar
        android:id="@+id/rsNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rsBarPaddingHorizontal="12dp"
        app:rsBarPaddingVertical="8dp"
        app:rsIconSize="24dp"
        app:rsIndicatorColor="@color/rs_text_brand_solid"
        app:rsIndicatorMode="topLine"
        app:rsLabelMode="selectedOnly"
        app:rsSelectedColor="@color/rs_text_brand_solid"
        app:rsUnselectedColor="@color/rs_text_secondary">

        <com.realsolutions.uikit.navbar.RSNavBarItemView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:rsIcon="@drawable/rs_ic_check"
            app:rsItemId="@id/nav_search"
            app:rsLabel="Ara" />

        <com.realsolutions.uikit.navbar.RSNavBarItemView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:rsBadge="3"
            app:rsIcon="@drawable/rs_ic_check"
            app:rsItemId="@id/nav_scan"
            app:rsLabel="Tara" />

        <com.realsolutions.uikit.navbar.RSNavBarItemView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:rsIcon="@drawable/rs_ic_check"
            app:rsItemId="@id/nav_profile"
            app:rsLabel="Profil" />

        <com.realsolutions.uikit.navbar.RSNavBarItemView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:rsIcon="@drawable/rs_ic_check"
            app:rsItemId="@id/nav_demo"
            app:rsLabel="Profil" />

        <com.realsolutions.uikit.navbar.RSNavBarItemView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:rsIcon="@drawable/rs_ic_check"
            app:rsItemId="@id/nav_demo_1"
            app:rsLabel="Profil" />

    </com.realsolutions.uikit.navbar.RSNavBar>


</androidx.constraintlayout.widget.ConstraintLayout>
