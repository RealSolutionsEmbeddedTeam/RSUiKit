<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_bg_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ========== RSInput (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSInput"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSInput
            android:id="@+id/inputExample"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsHelperText="This is a hint text to help user."
            app:rsHint="burak@realsolutions.com.tr"
            app:rsInputType="email"
            app:rsLabel="Email"
            app:rsRequired="true"
            app:rsShowInfo="true"
            app:rsSuffixText="(Optional)" />

        <!-- ========== RSAvatar (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSAvatar"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSAvatar
            android:id="@+id/avatarExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsAvatarHasBorder="true"
            app:rsAvatarSize="size_48"
            app:rsAvatarText="AB"
            app:rsAvatarType="brand"
            app:rsAvatarVariant="text" />

        <!-- ========== RSAvatarGroup (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSAvatarGroup"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSAvatarGroup
            android:id="@+id/avatarGroupExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsAvatarGroupMax="5"
            app:rsAvatarGroupSize="size_48">

            <com.realsolutions.uikit.RSAvatar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:rsAvatarText="A"
                app:rsAvatarType="brand"
                app:rsAvatarVariant="text" />

            <com.realsolutions.uikit.RSAvatar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:rsAvatarText="B"
                app:rsAvatarType="orange"
                app:rsAvatarVariant="text" />

            <com.realsolutions.uikit.RSAvatar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:rsAvatarText="C"
                app:rsAvatarType="purple"
                app:rsAvatarVariant="text" />

        </com.realsolutions.uikit.RSAvatarGroup>

        <!-- ========== RSCounterInput (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSCounterInput"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSCounterInput
            android:id="@+id/counterExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsCounterHint="This is a hint text to help user."
            app:rsCounterMaxValue="10"
            app:rsCounterMinValue="0"
            app:rsCounterStep="1"
            app:rsCounterSublabel="Sublabel"
            app:rsCounterValue="5"
            app:rsLabel="Quantity"
            app:rsRequired="true"
            app:rsShowInfo="true"
            app:rsSize="md" />

        <!-- ========== RSRadioCard (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSRadioCard"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSRadioCard
            android:id="@+id/radioCardExample"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsRadioCardDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore."
            app:rsRadioCardHelper="Helper Text"
            app:rsRadioCardLabel="Option Label"
            app:rsRadioCardSelected="false"
            app:rsRadioCardShowDescription="true"
            app:rsRadioCardShowHelper="true"
            app:rsSize="sm" />

        <!-- ========== RSTooltip (One example) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="RSTooltip"
            android:textColor="@color/rs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.realsolutions.uikit.RSTooltip
            android:id="@+id/tooltipExample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:rsTooltipActionType="two"
            app:rsTooltipArrowPosition="top_right"
            app:rsTooltipMessage="This is a tooltip message to help the user understand the feature."
            app:rsTooltipShowClose="true"
            app:rsTooltipTitle="Tooltip Title" />

    </LinearLayout>
</ScrollView>
