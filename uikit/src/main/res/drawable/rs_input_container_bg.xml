<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/rs_bg_primary" />
            <stroke android:width="1dp" android:color="@color/rs_border_brand_solid" />
            <corners android:radius="@dimen/rs_input_radius_new" />
        </shape>
    </item>
    <!-- Error State (Manual handling via level or custom state if needed, but let's use a standard color for now) -->
    <!-- We will apply these dynamically in Java for more precision as we did before,
         but providing a solid base here. -->
    <item>
        <shape>
            <solid android:color="@color/rs_bg_primary" />
            <stroke android:width="1dp" android:color="@color/rs_border_primary" />
            <corners android:radius="@dimen/rs_input_radius_new" />
        </shape>
    </item>
</selector>
