<?xml version="1.0" encoding="utf-8"?><!--
    RSRadioCard Accent Bar
    Left accent bar with top-left and bottom-left corner radius
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/rs_border_brand_solid_alt" />

    <!-- Only left corners have radius matching card radius -->
    <corners
        android:bottomLeftRadius="@dimen/rs_radius_xl"
        android:bottomRightRadius="0dp"
        android:topLeftRadius="@dimen/rs_radius_xl"
        android:topRightRadius="0dp" />

</shape>
