<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/rs_bg_brand_primary" />
            <corners android:radius="@dimen/rs_radius_xl" />
            <stroke android:width="1dp" android:color="@color/rs_border_brand_solid" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/rs_bg_primary" />
            <corners android:radius="@dimen/rs_radius_xl" />
            <stroke android:width="2dp" android:color="@color/rs_border_brand_solid_alt" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/rs_bg_primary" />
            <corners android:radius="@dimen/rs_radius_xl" />
            <stroke android:width="1dp" android:color="@color/rs_border_secondary" />
        </shape>
    </item>
</selector>