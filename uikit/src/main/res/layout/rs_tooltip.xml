<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:parentTag="android.widget.FrameLayout">

    <!-- Content Card - Figma: width 328dp, padding 16dp, gap 8dp -->
    <LinearLayout
        android:id="@+id/rsTooltipCard"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rs_tooltip_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Title + Close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rsTooltipTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/rs_text_white"
                android:textSize="18sp"
                tools:text="Title" />

            <ImageView
                android:id="@+id/rsTooltipClose"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/rs_ic_close_slim" />

        </LinearLayout>

        <!-- Message - margin top 8dp (gap) -->
        <TextView
            android:id="@+id/rsTooltipMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rs_text_white"
            android:textSize="14sp"
            tools:text="This is tooltip message, you can use it to educate user about the actions." />

        <!-- Actions - margin top 8dp (gap) -->
        <LinearLayout
            android:id="@+id/rsTooltipActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.realsolutions.uikit.RSButton
                android:id="@+id/rsTooltipBtnPrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Previous"
                app:rsSize="sm"
                app:rsType="neutral" />

            <com.realsolutions.uikit.RSButton
                android:id="@+id/rsTooltipBtnContinue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Continue"
                app:rsSize="sm"
                app:rsType="neutral" />

        </LinearLayout>

    </LinearLayout>

    <!-- Arrows - Each uses its own dedicated drawable with correct orientation -->
    <!-- Top arrow: 24dp x 8dp, points up -->
    <ImageView
        android:id="@+id/rsTooltipArrowTop"
        android:layout_width="24dp"
        android:layout_height="8dp"
        android:src="@drawable/rs_tooltip_arrow_up"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Bottom arrow: 24dp x 8dp, points down -->
    <ImageView
        android:id="@+id/rsTooltipArrowBottom"
        android:layout_width="24dp"
        android:layout_height="8dp"
        android:src="@drawable/rs_tooltip_arrow_down"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Left arrow: 8dp x 24dp, points left -->
    <ImageView
        android:id="@+id/rsTooltipArrowLeft"
        android:layout_width="8dp"
        android:layout_height="24dp"
        android:src="@drawable/rs_tooltip_arrow_left"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Right arrow: 8dp x 24dp, points right -->
    <ImageView
        android:id="@+id/rsTooltipArrowRight"
        android:layout_width="8dp"
        android:layout_height="24dp"
        android:src="@drawable/rs_tooltip_arrow_right"
        android:visibility="gone"
        tools:visibility="visible" />

</merge>
