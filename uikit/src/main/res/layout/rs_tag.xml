<?xml version="1.0" encoding="utf-8"?><!-- RSTag Layout
     Figma Specs:
     - inline-flex
     - padding: 4dp 12dp (without icon) / 4dp 12dp 4dp 8dp (with icon)
     - gap: 4dp
     - radius: 8dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rs_tag_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/rs_tag_padding_horizontal"
    android:paddingTop="@dimen/rs_tag_padding_vertical"
    android:paddingEnd="@dimen/rs_tag_padding_horizontal"
    android:paddingBottom="@dimen/rs_tag_padding_vertical"
    tools:background="@drawable/rs_tag_bg_neutral_default">

    <!-- Leading Icon (optional) -->
    <ImageView
        android:id="@+id/rs_tag_icon"
        android:layout_width="@dimen/rs_tag_icon_size"
        android:layout_height="@dimen/rs_tag_icon_size"
        android:layout_marginEnd="@dimen/rs_tag_gap"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:src="@drawable/rs_ic_tag"
        tools:visibility="visible" />

    <!-- Text -->
    <TextView
        android:id="@+id/rs_tag_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/rs_text_white"
        android:textSize="@dimen/rs_tag_text_size"
        tools:text="QR" />

</LinearLayout>
