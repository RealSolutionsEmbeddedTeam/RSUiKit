<resources>

    <!-- ===================== -->
    <!-- Shared attributes (ONLY ONCE) -->
    <!-- ===================== -->
    <attr name="rsLabel" format="string" />
    <attr name="rsHint" format="string" />
    <attr name="rsEnabled" format="boolean" />
    <attr name="rsText" format="string" />
    <attr name="rsState" format="enum">
        <enum name="normal" value="0" />
        <enum name="focused" value="1" />
        <enum name="error" value="2" />
        <enum name="success" value="3" />
        <enum name="hovered" value="4" />
    </attr>
    <attr name="rsSize" format="enum">
        <enum name="xs" value="0" />
        <enum name="sm" value="1" />
        <enum name="md" value="2" />
    </attr>
    <attr name="rsRequired" format="boolean" />
    <attr name="rsShowInfo" format="boolean" />
    <attr name="rsSuffixText" format="string" />
    <attr name="rsLeadingIcon" format="reference" />
    <attr name="rsTrailingIcon" format="reference" />

    <!-- ===================== -->
    <!-- RSButton -->
    <!-- ===================== -->
    <declare-styleable name="RSButton">
        <attr name="rsType" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="neutral" value="2" />
            <enum name="plain_dark" value="3" />
            <enum name="plain_light" value="4" />
        </attr>
        <attr name="rsSize" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSCheckBox -->
    <!-- ===================== -->
    <declare-styleable name="RSCheckBox">
        <attr name="rsSize" />
        <attr name="rsStatus" format="enum">
            <enum name="unchecked" value="0" />
            <enum name="checked" value="1" />
            <enum name="indeterminate" value="2" />
        </attr>
        <attr name="android:text" />
    </declare-styleable>

    <!-- Custom State for Selectors -->
    <attr name="state_indeterminate" format="boolean" />

    <!-- ===================== -->
    <!-- RSEditText -->
    <!-- ===================== -->
    <declare-styleable name="RSEditText">
        <attr name="rsLabel" />
        <attr name="rsHint" />
        <attr name="rsState" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSInput -->
    <!-- ===================== -->
    <declare-styleable name="RSInput">
        <attr name="rsLabel" />
        <attr name="rsText" />
        <attr name="rsHint" />
        <attr name="rsState" />
        <attr name="rsSize" />
        <attr name="rsEnabled" />
        <attr name="rsInputType" format="enum">
            <enum name="basic" value="0" />
            <enum name="email" value="1" />
            <enum name="password" value="2" />
            <enum name="search" value="3" />
            <enum name="website" value="4" />
            <enum name="date" value="5" />
            <enum name="link" value="6" />
            <enum name="dropdown" value="7" />
            <enum name="phone" value="8" />
            <enum name="button" value="9" />
        </attr>
        <attr name="rsRequired" />
        <attr name="rsShowInfo" />
        <attr name="rsSuffixText" />
        <attr name="rsPrefixText" format="string" />
        <attr name="rsHelperText" format="string" />
        <attr name="rsLeadingIcon" />
        <attr name="rsTrailingIcon" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSPasswordInput -->
    <!-- ===================== -->
    <declare-styleable name="RSPasswordInput">
        <attr name="rsLabel" />
        <attr name="rsHint" />
        <attr name="rsState" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSRadioButton -->
    <!-- ===================== -->
    <declare-styleable name="RSRadioButton">
        <attr name="rsSize" />
        <attr name="android:text" />
    </declare-styleable>


    <!-- ===================== -->
    <!-- RSLoadingCircle -->
    <!-- ===================== -->
    <declare-styleable name="RSLoadingCircle">
        <attr name="rsSpeed" format="float" />
        <!-- degrees per second -->
        <attr name="rsTrailDeg" format="float" />
        <!-- 0..360 -->
        <attr name="rsColor" format="color" />
        <!-- HEAD color -->
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSGridBackgroundView -->
    <!-- ===================== -->
    <declare-styleable name="GridBackgroundView">
        <attr name="gridRows" format="integer" />
        <attr name="gridColumns" format="integer" />
        <attr name="gridLineColor" format="color" />
        <attr name="gridLineWidth" format="dimension" />
        <attr name="gridPadding" format="dimension" />
        <attr name="gridShowOuterBorder" format="boolean" />
    </declare-styleable>


    <!-- RSCallout -->
    <declare-styleable name="RSCallout">
        <!-- Callout type: info, success, warning, error -->
        <attr name="rsCalloutType" format="enum">
            <enum name="info" value="0" />
            <enum name="success" value="1" />
            <enum name="warning" value="2" />
            <enum name="error" value="3" />
        </attr>
        <!-- Title text -->
        <attr name="rsCalloutTitle" format="string" />
        <!-- Message text -->
        <attr name="rsCalloutMessage" format="string" />
        <!-- Action button text -->
        <attr name="rsCalloutActionText" format="string" />
        <!-- Show/hide title -->
        <attr name="rsCalloutShowTitle" format="boolean" />
        <!-- Show/hide action button -->
        <attr name="rsCalloutShowAction" format="boolean" />
    </declare-styleable>


    <!-- ===================== -->
    <!-- RSDialog -->
    <!-- ===================== -->
    <declare-styleable name="RSDialog">
        <!-- Show/hide icon -->
        <attr name="rsDialogShowIcon" format="boolean" />
        <!-- Action type: default (2 buttons) or single (1 button) -->
        <attr name="rsDialogActionType" format="enum">
            <enum name="defaultAction" value="0" />
            <enum name="single" value="1" />
        </attr>
        <!-- Title text -->
        <attr name="rsDialogTitle" format="string" />
        <!-- Description text -->
        <attr name="rsDialogDescription" format="string" />
        <!-- Neutral button text -->
        <attr name="rsDialogNeutralText" format="string" />
        <!-- Primary button text -->
        <attr name="rsDialogPrimaryText" format="string" />
        <!-- Custom icon resource -->
        <attr name="rsDialogIcon" format="reference" />
        <!-- Animate icon rotation -->
        <attr name="rsDialogAnimateIcon" format="boolean" />
        <!-- Neutral button type (uses RSButton types) -->
        <attr name="rsDialogNeutralButtonType" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="neutral" value="2" />
            <enum name="plainDark" value="3" />
            <enum name="plainLight" value="4" />
        </attr>
        <!-- Primary button type (uses RSButton types) -->
        <attr name="rsDialogPrimaryButtonType" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="neutral" value="2" />
            <enum name="plainDark" value="3" />
            <enum name="plainLight" value="4" />
        </attr>
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSLoadingBar -->
    <!-- ===================== -->
    <declare-styleable name="RSLoadingBar">
        <!-- Progress level 0-100 -->
        <attr name="rsLevel" format="integer" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSNavBar -->
    <!-- ===================== -->

    <declare-styleable name="RSNavBar">
        <attr name="rsLabelMode" format="enum">
            <enum name="always" value="0" />
            <enum name="selectedOnly" value="1" />
            <enum name="never" value="2" />
        </attr>

        <attr name="rsIndicatorMode" format="enum">
            <enum name="topLine" value="0" />
            <enum name="dot" value="1" />
            <enum name="none" value="2" />
        </attr>

        <attr name="rsIconSize" format="dimension" />
        <attr name="rsBarPaddingHorizontal" format="dimension" />
        <attr name="rsBarPaddingVertical" format="dimension" />

        <attr name="rsSelectedColor" format="color|reference" />
        <attr name="rsUnselectedColor" format="color|reference" />
        <attr name="rsIndicatorColor" format="color|reference" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSNavBarItem -->
    <!-- ===================== -->

    <declare-styleable name="RSNavBarItem">
        <attr name="rsItemId" format="reference|integer" />
        <attr name="rsIcon" format="reference" />
        <attr name="rsLabel" />
        <attr name="rsEnabled" />
        <attr name="rsBadge" format="string" />
        <attr name="rsItemIconSize" format="dimension" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSLabel -->
    <!-- ===================== -->

    <declare-styleable name="RSLabel">
        <attr name="rsText" />
        <attr name="rsRequired" />
        <attr name="rsSuffixText" />
        <attr name="rsShowInfo" />
        <attr name="rsEnabled" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSHelperText -->
    <!-- ===================== -->

    <declare-styleable name="RSHelperText">
        <attr name="rsText" />
        <attr name="rsState" />
        <attr name="rsEnabled" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSSelect -->
    <!-- ===================== -->

    <declare-styleable name="RSSelect">
        <attr name="rsPlaceholder" format="string" />
        <attr name="rsLeadingIcon" />
        <attr name="rsState" />
        <attr name="rsEnabled" />
        <attr name="rsClearable" format="boolean" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSTextArea -->
    <!-- ===================== -->

    <declare-styleable name="RSTextArea">
        <attr name="rsHint" />
        <attr name="rsText" />
        <attr name="rsMaxLength" format="integer" />
        <attr name="rsShowCounter" format="boolean" />
        <attr name="rsState" />
        <attr name="rsEnabled" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSMenu -->
    <!-- ===================== -->

    <declare-styleable name="RSMenu">
        <!-- Optional fixed width for the menu -->
        <attr name="rsMenuWidth" format="dimension" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSMenuItem -->
    <!-- ===================== -->

    <declare-styleable name="RSMenuItem">
        <!-- Leading icon resource -->
        <attr name="rsMenuItemIcon" format="reference" />
        <!-- Show/hide leading icon -->
        <attr name="rsMenuItemIconVisible" format="boolean" />
        <!-- Label text -->
        <attr name="rsMenuItemLabel" format="string" />
        <!-- MenuItem state -->
        <attr name="rsMenuItemState" format="enum">
            <enum name="normal" value="0" />
            <enum name="hover" value="1" />
            <enum name="focus" value="2" />
            <enum name="selected" value="3" />
            <enum name="disabled" value="4" />
        </attr>
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSSnackbar -->
    <!-- ===================== -->

    <declare-styleable name="RSSnackbar">
        <!-- Snackbar type: informative, success, critical -->
        <attr name="rsSnackbarType" format="enum">
            <enum name="informative" value="0" />
            <enum name="success" value="1" />
            <enum name="critical" value="2" />
        </attr>
        <!-- Message text -->
        <attr name="rsSnackbarMessage" format="string" />
        <!-- Action button text -->
        <attr name="rsSnackbarActionText" format="string" />
        <!-- Show/hide action button -->
        <attr name="rsSnackbarShowAction" format="boolean" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSTag -->
    <!-- ===================== -->
    <declare-styleable name="RSTag">
        <!-- Tag type: default (solid bg) or subdued (light bg) -->
        <attr name="rsTagType" format="enum">
            <enum name="tag_default" value="0" />
            <enum name="subdued" value="1" />
        </attr>
        <!-- Tag variant: color scheme -->
        <attr name="rsTagVariant" format="enum">
            <enum name="informative" value="0" />
            <enum name="success" value="1" />
            <enum name="warning" value="2" />
            <enum name="critical" value="3" />
            <enum name="neutral" value="4" />
        </attr>
        <!-- Tag text -->
        <attr name="rsTagText" format="string" />
        <!-- Show leading icon -->
        <attr name="rsTagShowIcon" format="boolean" />
        <!-- Custom icon resource -->
        <attr name="rsTagIcon" format="reference" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSStatusBadge -->
    <!-- ===================== -->
    <declare-styleable name="RSStatusBadge">
        <!-- Status Badge status: determines color scheme -->
        <attr name="rsStatusBadgeStatus" format="enum">
            <enum name="success" value="0" />
            <enum name="warning" value="1" />
            <enum name="error" value="2" />
            <enum name="information" value="3" />
            <enum name="badge_default" value="4" />
        </attr>
        <!-- Status Badge variant: background style -->
        <attr name="rsStatusBadgeVariant" format="enum">
            <enum name="linked" value="0" />
            <enum name="contained" value="1" />
            <enum name="outlined" value="2" />
        </attr>
        <!-- Status Badge type: leading indicator -->
        <attr name="rsStatusBadgeType" format="enum">
            <enum name="dot" value="0" />
            <enum name="icon" value="1" />
        </attr>
        <!-- Status Badge text -->
        <attr name="rsStatusBadgeText" format="string" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSBadge (New Figma Design) -->
    <!-- ===================== -->
    <declare-styleable name="RSBadge">
        <!-- Badge type: layout configuration -->
        <attr name="rsBadgeType" format="enum">
            <enum name="basic" value="0" />
            <enum name="left_icon" value="1" />
            <enum name="right_icon" value="2" />
            <enum name="with_dot" value="3" />
        </attr>
        <!-- Badge style: visual appearance -->
        <attr name="rsBadgeStyle" format="enum">
            <enum name="light" value="0" />
            <enum name="lighter" value="1" />
            <enum name="stroke" value="2" />
        </attr>
        <!-- Badge color: color scheme -->
        <attr name="rsBadgeColor" format="enum">
            <enum name="badge_default" value="0" />
            <enum name="brand" value="1" />
            <enum name="warning" value="2" />
            <enum name="error" value="3" />
            <enum name="success" value="4" />
        </attr>

        <!-- Badge text -->
        <attr name="rsBadgeText" format="string" />
        <!-- Badge number (shows number instead of text when > 0) -->
        <attr name="rsBadgeNumber" format="integer" />
        <!-- Badge icon (for left_icon and right_icon types) -->
        <attr name="rsBadgeIcon" format="reference" />
    </declare-styleable>

    <!-- RSTabItem: Individual tab button component -->
    <declare-styleable name="RSTabItem">
        <!-- Tab type: visual style -->
        <attr name="rsTabType" format="enum">
            <enum name="full_circle" value="0" />
            <enum name="underline" value="1" />
        </attr>
        <!-- Tab size: small or medium -->
        <attr name="rsTabSize" format="enum">
            <enum name="small" value="0" />
            <enum name="medium" value="1" />
        </attr>
        <!-- Tab label text -->
        <attr name="rsTabLabel" format="string" />
        <!-- Tab icon: leading icon drawable -->
        <attr name="rsTabIcon" format="reference" />
        <!-- Tab counter: trailing count number (shows as badge) -->
        <attr name="rsTabCounter" format="integer" />
        <!-- Tab state: visual state -->
        <attr name="rsTabState" format="enum">
            <enum name="normal" value="0" />
            <enum name="hover" value="1" />
            <enum name="focus" value="2" />
            <enum name="selected" value="3" />
        </attr>
        <!-- Tab icon visibility: show/hide icon (default: true if icon is set) -->
        <attr name="rsTabIconVisible" format="boolean" />
        <!-- Tab counter visibility: show/hide counter (default: true if counter >= 0) -->
        <attr name="rsTabCounterVisible" format="boolean" />
    </declare-styleable>


    <!-- ===================== -->
    <!-- RSRadioCard -->
    <!-- ===================== -->

    <declare-styleable name="RSRadioCard">
        <!-- Card label text -->
        <attr name="rsRadioCardLabel" format="string" />
        <!-- Description text below label -->
        <attr name="rsRadioCardDescription" format="string" />
        <!-- Helper text at bottom -->
        <attr name="rsRadioCardHelper" format="string" />
        <!-- Show description -->
        <attr name="rsRadioCardShowDescription" format="boolean" />
        <!-- Show helper -->
        <attr name="rsRadioCardShowHelper" format="boolean" />
        <!-- Selected state (Status: True/False in Figma) -->
        <attr name="rsRadioCardSelected" format="boolean" />
        <!-- Enabled state -->
        <attr name="rsRadioCardEnabled" format="boolean" />
        <!-- Size: sm (16dp) or md (20dp) radio indicator -->
        <attr name="rsSize" />
        <!-- Visual state for preview/demo (State in Figma) -->
        <attr name="rsRadioCardState" format="enum">
            <enum name="default_state" value="0" />
            <enum name="hover" value="1" />
            <enum name="focus" value="2" />
            <enum name="pressed" value="3" />
        </attr>
    </declare-styleable>


    <!-- ===================== -->
    <!-- RSTooltip -->
    <!-- ===================== -->
    <declare-styleable name="RSTooltip">
        <!-- Title text -->
        <attr name="rsTooltipTitle" format="string" />
        <!-- Message text -->
        <attr name="rsTooltipMessage" format="string" />
        <!-- Arrow position (12 directions) -->
        <attr name="rsTooltipArrowPosition" format="enum">
            <enum name="top_left" value="0" />
            <enum name="top_center" value="1" />
            <enum name="top_right" value="2" />
            <enum name="bottom_left" value="3" />
            <enum name="bottom_center" value="4" />
            <enum name="bottom_right" value="5" />
            <enum name="left_top" value="6" />
            <enum name="left_center" value="7" />
            <enum name="left_bottom" value="8" />
            <enum name="right_top" value="9" />
            <enum name="right_center" value="10" />
            <enum name="right_bottom" value="11" />
        </attr>
        <!-- Action type: none, one (Continue), two (Previous + Continue) -->
        <attr name="rsTooltipActionType" format="enum">
            <enum name="none" value="0" />
            <enum name="one" value="1" />
            <enum name="two" value="2" />
        </attr>
        <!-- Show/hide close button -->
        <attr name="rsTooltipShowClose" format="boolean" />
    </declare-styleable>


    <!-- ===================== -->
    <!-- RSCounterInput -->
    <!-- ===================== -->
    <declare-styleable name="RSCounterInput">
        <attr name="rsSize" />
        <attr name="rsState" />
        <attr name="rsLabel" />
        <attr name="rsRequired" />
        <attr name="rsCounterSublabel" format="string" />
        <attr name="rsShowInfo" />
        <attr name="rsCounterHint" format="string" />
        <attr name="rsCounterValue" format="integer" />
        <attr name="rsCounterMinValue" format="integer" />
        <attr name="rsCounterMaxValue" format="integer" />
        <attr name="rsCounterStep" format="integer" />
        <attr name="rsEnabled" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSAvatar -->
    <!-- ===================== -->
    <declare-styleable name="RSAvatar">
        <!-- Avatar size: size_88, size_72, ..., size_16 -->
        <attr name="rsAvatarSize" format="enum">
            <enum name="size_88" value="0" />
            <enum name="size_72" value="1" />
            <enum name="size_64" value="2" />
            <enum name="size_56" value="3" />
            <enum name="size_48" value="4" />
            <enum name="size_36" value="5" />
            <enum name="size_32" value="6" />
            <enum name="size_28" value="7" />
            <enum name="size_24" value="8" />
            <enum name="size_20" value="9" />
            <enum name="size_16" value="10" />
        </attr>
        <!-- Content variant -->
        <attr name="rsAvatarVariant" format="enum">
            <enum name="image" value="0" />
            <enum name="text" value="1" />
            <enum name="icon" value="2" />
            <enum name="memoji" value="3" />
        </attr>
        <!-- Color scheme -->
        <attr name="rsAvatarType" format="enum">
            <enum name="neutral" value="0" />
            <enum name="brand" value="1" />
            <enum name="success" value="2" />
            <enum name="warning" value="3" />
            <enum name="error" value="4" />
            <enum name="yellow" value="5" />
            <enum name="orange" value="6" />
            <enum name="purple" value="7" />
        </attr>
        <!-- Initials text for text variant -->
        <attr name="rsAvatarText" format="string" />
        <!-- Image resource -->
        <attr name="rsAvatarImage" format="reference" />
        <!-- Custom icon resource -->
        <attr name="rsAvatarIcon" format="reference" />
        <!-- Show white border (useful in groups) -->
        <attr name="rsAvatarHasBorder" format="boolean" />
    </declare-styleable>

    <!-- ===================== -->
    <!-- RSAvatarGroup -->
    <!-- ===================== -->
    <declare-styleable name="RSAvatarGroup">
        <!-- Size for all avatars in the group -->
        <attr name="rsAvatarGroupSize" format="enum">
            <enum name="size_88" value="0" />
            <enum name="size_72" value="1" />
            <enum name="size_64" value="2" />
            <enum name="size_56" value="3" />
            <enum name="size_48" value="4" />
            <enum name="size_36" value="5" />
            <enum name="size_32" value="6" />
            <enum name="size_28" value="7" />
            <enum name="size_24" value="8" />
            <enum name="size_20" value="9" />
            <enum name="size_16" value="10" />
        </attr>
        <!-- Max number of avatars to display -->
        <attr name="rsAvatarGroupMax" format="integer" />
    </declare-styleable>

</resources>
